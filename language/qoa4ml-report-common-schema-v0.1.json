{
    "$defs": {
        "DataQualityEnum": {
            "enum": [
                "data_accuracy",
                "completeness",
                "total_errors",
                "error_ratios",
                "duplicate_ratio",
                "total_duplicate",
                "null_count",
                "null_correlations",
                "total_valid",
                "total_none",
                "none_ratio"
            ],
            "title": "DataQualityEnum",
            "type": "string"
        },
        "FlattenMetric": {
            "properties": {
                "metric_name": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ServiceQualityEnum"
                        },
                        {
                            "$ref": "#/$defs/MLModelQualityEnum"
                        },
                        {
                            "$ref": "#/$defs/DataQualityEnum"
                        },
                        {
                            "$ref": "#/$defs/ResourcesUtilizationMetricNameEnum"
                        },
                        {
                            "$ref": "#/$defs/ImageQualityNameEnum"
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "title": "Metric Name"
                },
                "records": {
                    "items": {
                        "anyOf": [
                            {
                                "type": "object"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "type": "integer"
                            },
                            {
                                "items": {},
                                "type": "array"
                            },
                            {
                                "type": "string"
                            }
                        ]
                    },
                    "title": "Records",
                    "type": "array"
                },
                "unit": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Unit"
                },
                "description": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Description"
                },
                "stage": {
                    "title": "Stage",
                    "type": "string"
                },
                "report_type": {
                    "$ref": "#/$defs/ReportTypeEnum"
                },
                "instance": {
                    "$ref": "#/$defs/MicroserviceInstance"
                },
                "previous_instances": {
                    "items": {
                        "$ref": "#/$defs/MicroserviceInstance"
                    },
                    "title": "Previous Instances",
                    "type": "array"
                }
            },
            "required": [
                "metric_name",
                "stage",
                "report_type",
                "instance",
                "previous_instances"
            ],
            "title": "FlattenMetric",
            "type": "object"
        },
        "ImageQualityNameEnum": {
            "enum": [
                "image_size",
                "object_size",
                "color_mode",
                "color_channel"
            ],
            "title": "ImageQualityNameEnum",
            "type": "string"
        },
        "MLModelQualityEnum": {
            "enum": [
                "auc",
                "model_accuracy",
                "mse",
                "precision",
                "recall"
            ],
            "title": "MLModelQualityEnum",
            "type": "string"
        },
        "MicroserviceInstance": {
            "properties": {
                "id": {
                    "format": "uuid",
                    "title": "Id",
                    "type": "string"
                },
                "name": {
                    "title": "Name",
                    "type": "string"
                },
                "functionality": {
                    "default": "",
                    "title": "Functionality",
                    "type": "string"
                },
                "stage": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Stage"
                }
            },
            "required": [
                "id",
                "name"
            ],
            "title": "MicroserviceInstance",
            "type": "object"
        },
        "ReportTypeEnum": {
            "enum": [
                "data_report",
                "service_report",
                "ml_specific_report",
                "security_report"
            ],
            "title": "ReportTypeEnum",
            "type": "string"
        },
        "ResourcesUtilizationMetricNameEnum": {
            "enum": [
                "cpu_usage",
                "memory_usage"
            ],
            "title": "ResourcesUtilizationMetricNameEnum",
            "type": "string"
        },
        "ServiceQualityEnum": {
            "enum": [
                "availability",
                "reliability",
                "response_time"
            ],
            "title": "ServiceQualityEnum",
            "type": "string"
        }
    },
    "properties": {
        "metadata": {
            "title": "Metadata",
            "type": "object"
        },
        "metrics": {
            "items": {
                "$ref": "#/$defs/FlattenMetric"
            },
            "title": "Metrics",
            "type": "array"
        }
    },
    "title": "GeneralApplicationReportModel",
    "type": "object"
}