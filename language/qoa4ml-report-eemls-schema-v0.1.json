    "properties": {
        "metadata": {
            "title": "Metadata",
            "type": "object"
        },
        "inference_report": {
            "anyOf": [
                {
                    "$ref": "#/$defs/EnsembleInferenceReport"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "execution_graph": {
            "anyOf": [
                {
                    "$ref": "#/$defs/ExecutionGraph"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        }
    },
    "title": "RoheReportModel",
    "type": "object"
}